{
  "description": "Keep the Plinth discipline active in main sessions and subagents.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/plinth.js\" inject SessionStart",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:PLUGIN_ROOT\\hooks\\plinth.js\" inject SessionStart }",
            "timeout": 5,
            "statusMessage": "Loading the Plinth discipline.",
            "additionalContextLimit": 750
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/plinth.js\" inject SubagentStart",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:PLUGIN_ROOT\\hooks\\plinth.js\" inject SubagentStart }",
            "timeout": 5,
            "statusMessage": "Loading the Plinth discipline.",
            "additionalContextLimit": 750
          }
        ]
      }
    ]
  }
}
